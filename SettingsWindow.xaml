                            <TextBlock Text="Media App Ignore Rules" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="Lyrictified remembers apps that expose media sessions. Enable ignore for apps you never want to drive lyrics, like web browsers or background players." />
                            <TextBlock x:Name="DetectedAppsEmptyStateTextBlock"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Text="No media apps detected yet. Start playback in an app and reopen this tab." />

                            <ListBox x:Name="DetectedAppsListBox"
                                     Visibility="Collapsed"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     SelectionMode="Single"
                                     Margin="-8,0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AppId}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Content="Ignore"
                                                      IsChecked="{Binding IsIgnored}"
                                                      Checked="DetectedAppIgnoreCheckBox_OnChanged"
                                                      Unchecked="DetectedAppIgnoreCheckBox_OnChanged" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="About">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,8,4,4">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <TextBlock Text="Lyrictified"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="AppVersionTextBlock"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Beautiful, synced lyrics for your desktop."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Contributors" Style="{StaticResource SectionTitleStyle}" />
                            <ItemsControl x:Name="ContributorsItemsControl">
                                <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                        <Grid Margin="0,8,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="88" Height="88" VerticalAlignment="Top">
                                                <Ellipse Fill="{StaticResource BorderBrush}" />
                                                <TextBlock Text="{Binding Initial}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="28"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Ellipse RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CommitSummary}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="13"
                                                           Margin="0,4,0,10" />
                                                <Button Tag="{Binding GitHubUrl}" Click="OpenContributorGitHubButton_OnClick" HorizontalAlignment="Left" Padding="12,6" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0">
                                                    <Button.Resources><Style TargetType="Button"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter></Style></Button.Resources>
                                                    <TextBlock Text="Open GitHub" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem x:Name="DebugTabItem" Header="Debug" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,8,4,4">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Debug Controls" Style="{StaticResource SectionTitleStyle}" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Force simulate no lyrics" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="Forces the app to show 'no lyrics found' state immediately." Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <Button x:Name="ForceNoLyricsButton"
                                        Grid.Column="1"
                                        Content="Trigger"
                                        Margin="0"
                                        Padding="12,6"
                                        HorizontalAlignment="Left"
                                        Background="#1C2128"
                                        Foreground="#E6EDF3"
                                        BorderBrush="#F85149"
                                        Click="ForceNoLyricsButton_OnClick" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Force simulate lyrics" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="Shows 100 fake lyric lines for testing display." Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <Button x:Name="ForceSimulateLyricsButton"
                                        Grid.Column="1"
                                        Content="Trigger"
                                        Margin="0"
                                        Padding="12,6"
                                        HorizontalAlignment="Left"
                                        Background="#1C2128"
                                        Foreground="#E6EDF3"
                                        BorderBrush="#58A6FF"
                                        Click="ForceSimulateLyricsButton_OnClick" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Force lyrics source" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="Restrict lyrics search to a single source." Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="DebugForceLyricsSourceComboBox"
                                          Grid.Column="1"
                                          MinWidth="180"
                                          VerticalAlignment="Center"
                                          SelectionChanged="DebugForceLyricsSourceComboBox_OnSelectionChanged">
                                    <ComboBoxItem Tag="" Content="Disable" />
                                    <ComboBoxItem Tag="Local" Content="Lyrictified Server API" />
                                    <ComboBoxItem Tag="LrcLib" Content="lrclib.net" />
                                    <ComboBoxItem Tag="Synced" Content="syncedlyrics" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Last Lyrics Search" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Shows the most recent search query and result. Useful for debugging which song data was sent." Style="{StaticResource LabelStyle}" />
                            <TextBox x:Name="LastSearchInfoTextBox"
                                     IsReadOnly="True"
                                     Margin="0,8,0,0"
                                     TextWrapping="Wrap"
                                     MaxHeight="120"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#0A0E14"
                                     Foreground="#9DB1C4"
                                     BorderBrush="#365067"
                                     FontSize="11"
                                     FontFamily="Consolas"
                                     Text="No search yet" />
                             <Button x:Name="ForceResearchButton"
                                     Content="Force re-search lyrics"
                                     Margin="0,12,0,0"
                                     Padding="12,6"
                                     HorizontalAlignment="Left"
                                     Background="#1C2128"
                                     Foreground="#E6EDF3"
                                     BorderBrush="#58A6FF"
                                     Click="ForceResearchButton_OnClick" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="VM Detection Info" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Shows the results of the VM detection checks. Useful for debugging false positives." Style="{StaticResource LabelStyle}" />
                            <TextBox x:Name="VmDetectionInfoTextBox"
                                     IsReadOnly="True"
                                     Margin="0,8,0,0"
                                     TextWrapping="Wrap"
                                     MaxHeight="200"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#0A0E14"
                                     Foreground="#9DB1C4"
                                     BorderBrush="#365067"
                                     FontSize="11"
                                     FontFamily="Consolas"
                                     Text="No detection data yet" />
                            <Button x:Name="RefreshVmDetectionButton"
                                    Content="Refresh detection"
                                    Margin="0,12,0,0"
                                    Padding="12,6"
                                    HorizontalAlignment="Left"
                                    Background="#1C2128"
                                    Foreground="#E6EDF3"
                                    BorderBrush="#58A6FF"
                                    Click="RefreshVmDetectionButton_OnClick" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
