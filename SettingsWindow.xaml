<Window x:Class="Lyrictified.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyrictified Settings"
        Width="860"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161B22" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#58A6FF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#79C0FF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F85149" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0D1117" />
        <SolidColorBrush x:Key="CardBrush" Color="#1C2128" />

        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0D1117" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6EDF3" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1C2128" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E6EDF3" />
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8B949E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1C2128" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E6EDF3" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1C2128" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E6EDF3" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1"
                                                        Background="#1C2128"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1,0,0,0">
                                                    <Path HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="{StaticResource TextSecondaryBrush}"
                                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#1C2128" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#1C2128" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False" />
                            <Popup Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      SnapsToDevicePixels="True">
                                    <Border Background="{StaticResource InputBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6" />
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1C2128" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1C2128" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C2128" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C2128" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="2,0,0,0" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="SettingsTabControl"
                TabStripPlacement="Left"
                Margin="16">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="#0F1318"
                            CornerRadius="8"
                            Padding="4"
                            Margin="0,0,12,0">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                    <Border Grid.Column="1"
                            Background="Transparent">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,8,4,4">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Display Mode" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Choose where lyrics appear on your screen." Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="DisplayModeComboBox"
                                      MinWidth="260"
                                      SelectionChanged="DisplayModeComboBox_OnSelectionChanged">
                                <ComboBoxItem Tag="AppBar" Content="App bar (top of screen)" />
                                <ComboBoxItem Tag="Taskbar" Content="Taskbar" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Lyrics Cache" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Cache lyrics locally for instant loading on repeat plays. Set to 0 to disable." Style="{StaticResource LabelStyle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MaxCacheSizeTextBox"
                                         Grid.Column="0"
                                         Width="80"
                                         VerticalAlignment="Center"
                                         TextAlignment="Center"
                                         MaxLength="3"
                                         PreviewTextInput="MaxCacheSizeTextBox_PreviewTextInput"
                                         DataObject.Pasting="MaxCacheSizeTextBox_Pasting"
                                         TextChanged="MaxCacheSizeTextBox_OnTextChanged" />
                                <TextBlock Grid.Column="1"
                                           Text="songs max"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource LabelStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Last Lyrics Search" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Shows the most recent search query and result. Useful for debugging which song data was sent." Style="{StaticResource LabelStyle}" />
                            <TextBox x:Name="LastSearchInfoTextBox"
                                     IsReadOnly="True"
                                     Margin="0,8,0,0"
                                     TextWrapping="Wrap"
                                     MaxHeight="120"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#0A0E14"
                                     Foreground="#9DB1C4"
                                     BorderBrush="#365067"
                                     FontSize="11"
                                     FontFamily="Consolas"
                                     Text="No search yet" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="App Bar">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,8,4,4">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Lyric Display" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Show next line" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="Preview the upcoming lyric line below the current one." Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="ShowNextLineComboBox"
                                          Grid.Column="1"
                                          MinWidth="120"
                                          VerticalAlignment="Center"
                                          SelectionChanged="ShowNextLineComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="Disabled" />
                                    <ComboBoxItem Content="Enabled" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Lyric alignment" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="Position lyrics within the bar." Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="LyricAlignmentComboBox"
                                          Grid.Column="1"
                                          MinWidth="120"
                                          VerticalAlignment="Center"
                                          SelectionChanged="LyricAlignmentComboBox_OnSelectionChanged">
                                    <ComboBoxItem Tag="Left" Content="Left" />
                                    <ComboBoxItem Tag="Center" Content="Center" />
                                    <ComboBoxItem Tag="Right" Content="Right" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Show album art" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="Display album artwork and song info on the left side." Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="ShowAlbumArtComboBox"
                                          Grid.Column="1"
                                          MinWidth="120"
                                          VerticalAlignment="Center"
                                          SelectionChanged="ShowAlbumArtComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="Enabled" />
                                    <ComboBoxItem Content="Disabled" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Word-by-word lyrics" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="Highlight each word as it is sung (requires LRC word timestamps)." Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="WordByWordComboBox"
                                          Grid.Column="1"
                                          MinWidth="120"
                                          VerticalAlignment="Center"
                                          SelectionChanged="WordByWordComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="Disabled" />
                                    <ComboBoxItem Content="Enabled" />
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Hide mode" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="Control bar visibility when lyrics are not found." Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="HideModeComboBox"
                                          Grid.Column="1"
                                          MinWidth="120"
                                          VerticalAlignment="Center"
                                          SelectionChanged="HideModeComboBox_OnSelectionChanged">
                                    <ComboBoxItem Tag="Nothing" Content="Nothing" />
                                    <ComboBoxItem Tag="Blackout" Content="Blackout" />
                                    <ComboBoxItem Tag="Hide" Content="Hide" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Bar Height" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Custom pixel height. Leave empty for automatic sizing (80px default, 136px with next line)." Style="{StaticResource LabelStyle}" />
                            <TextBox x:Name="CustomHeightTextBox"
                                     MinWidth="260"
                                     MaxWidth="260"
                                     TextChanged="CustomHeightTextBox_OnTextChanged" />
                            <TextBlock x:Name="BarHeightHintTextBlock"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="Leave empty to use the automatic 80px height for this mode." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Test Mode" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Detach the bar from the screen edge and allow free resizing and repositioning." Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="Useful for testing the bar at different sizes without it being locked to the top of the screen." Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="TestModeComboBox"
                                          Grid.Column="1"
                                          MinWidth="120"
                                          VerticalAlignment="Center"
                                          SelectionChanged="TestModeComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="Disabled" />
                                    <ComboBoxItem Content="Enabled" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Display Monitor" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Choose which monitor to display the bar on." Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="AppBarMonitorComboBox"
                                      MinWidth="260"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="DeviceName"
                                      SelectionChanged="AppBarMonitorComboBox_OnSelectionChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Taskbar">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,8,4,4">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Display Monitor" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Choose which monitor to display lyrics on." Style="{StaticResource LabelStyle}" />
                            <ComboBox x:Name="TaskbarMonitorComboBox"
                                      MinWidth="260"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="DeviceName"
                                      SelectionChanged="TaskbarMonitorComboBox_OnSelectionChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Maximum Width" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Custom maximum width in pixels. Leave empty for default." Style="{StaticResource LabelStyle}" />
                            <TextBox x:Name="TaskbarMaximumWidthTextBox"
                                     MinWidth="260"
                                     MaxWidth="260"
                                     TextChanged="TaskbarMaximumWidthTextBox_OnTextChanged" />
                            <TextBlock x:Name="TaskbarMaximumWidthHintTextBlock"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="Leave empty to use the default 880px taskbar width cap." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Detected Apps">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,8,4,4">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Media App Ignore Rules" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="Lyrictified remembers apps that expose media sessions. Enable ignore for apps you never want to drive lyrics, like web browsers or background players." />
                            <TextBlock x:Name="DetectedAppsEmptyStateTextBlock"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Text="No media apps detected yet. Start playback in an app and reopen this tab." />

                            <ListBox x:Name="DetectedAppsListBox"
                                     Visibility="Collapsed"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     SelectionMode="Single"
                                     Margin="-8,0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AppId}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Content="Ignore"
                                                      IsChecked="{Binding IsIgnored}"
                                                      Checked="DetectedAppIgnoreCheckBox_OnChanged"
                                                      Unchecked="DetectedAppIgnoreCheckBox_OnChanged" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>