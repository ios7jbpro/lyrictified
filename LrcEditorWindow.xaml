<Window x:Class="Lyrictified.LrcEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LRC Editor"
        Width="720"
        Height="580"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161B22" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#58A6FF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#79C0FF" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0D1117" />
        <SolidColorBrush x:Key="CardBrush" Color="#1C2128" />
    </Window.Resources>

    <Border x:Name="SurfaceBorder"
            Background="#66101A25"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True"
            Padding="0">
        <Grid x:Name="MainGrid"
              Margin="18,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarGrid"
                  Grid.Row="0"
                  Margin="-8,-4,-8,4">
                <TextBlock Text="LRC Editor"
                           VerticalAlignment="Center"
                           Margin="10,0,128,0"
                           Foreground="#DDE9F4"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False" />

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Width="40"
                            Height="30"
                            Padding="0"
                            Click="MinimizeButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0">
                        <Image Source="Assets/minimize.png"
                               Width="10"
                               Height="10"
                               Stretch="Uniform" />
                    </Button>
                    <Button x:Name="CloseWindowButton"
                            Width="40"
                            Height="30"
                            Padding="0"
                            Click="CloseWindowButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0">
                        <Image Source="Assets/close.png"
                               Width="10"
                               Height="10"
                               Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="#1C2128"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,4,0,8"
                    Padding="12">
                <TextBox x:Name="EditorTextBox"
                         Background="Transparent"
                         Foreground="#E6EDF3"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="13"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         CaretBrush="#58A6FF"
                         TextChanged="EditorTextBox_OnTextChanged" />
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <Button x:Name="AddTimestampButton"
                            Content="Add timestamp"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Background="#1C2128"
                            Foreground="#E6EDF3"
                            BorderBrush="#30363D"
                            Click="AddTimestampButton_OnClick" />
                    <Button x:Name="AddCurrentTimestampButton"
                            Content="Add current timestamp"
                            Padding="12,6"
                            Background="#1C2128"
                            Foreground="#E6EDF3"
                            BorderBrush="#30363D"
                            Click="AddCurrentTimestampButton_OnClick" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button x:Name="SaveButton"
                            Content="Save"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Background="#1C2128"
                            Foreground="#E6EDF3"
                            BorderBrush="#58A6FF"
                            Click="SaveButton_OnClick" />
                    <Button x:Name="SaveToDiskButton"
                            Content="Save to disk"
                            Padding="12,6"
                            Background="#1C2128"
                            Foreground="#E6EDF3"
                            BorderBrush="#58A6FF"
                            Click="SaveToDiskButton_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
