<Window x:Class="Lyrictified.DebugStartupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lyrictified - Debug Build"
        Width="540"
        Height="260"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E" />
        <SolidColorBrush x:Key="CardBrush" Color="#1C2128" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A3038" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#333A44" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#161B22"
            BorderBrush="#30363D"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarGrid"
                  Grid.Row="0"
                  Margin="0">
                <TextBlock Text="Lyrictified - Debug Build"
                           VerticalAlignment="Center"
                           Margin="16,0,96,0"
                           Foreground="#DDE9F4"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False" />

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Width="40"
                            Height="30"
                            Padding="0"
                            Click="MinimizeButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0">
                        <Image Source="Assets/minimize.png"
                               Width="10"
                               Height="10"
                               Stretch="Uniform" />
                    </Button>
                    <Button x:Name="CloseWindowButton"
                            Width="40"
                            Height="30"
                            Padding="0"
                            Click="CloseWindowButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0">
                        <Image Source="Assets/close.png"
                               Width="10"
                               Height="10"
                               Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="20,10,20,20">
                <TextBlock Text="You are running a debug build. We suggest that if you are editing or developing this app further, you run it alongside Lyrictified-Server, so that you can troubleshoot the whole ecosystem.&#x0a;&#x0a;If you already are, pick it from below. If you are not, pick the other option that will use the public URL instead."
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,16" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                    <Button x:Name="BtnLocal"
                            Content="Use local URL"
                            Width="120"
                            Margin="0,0,8,0"
                            Style="{StaticResource DialogButtonStyle}"
                            Click="BtnLocal_OnClick" />
                    <Button x:Name="BtnPublic"
                            Content="Use public URL"
                            Width="120"
                            Margin="0,0,8,0"
                            Style="{StaticResource DialogButtonStyle}"
                            Click="BtnPublic_OnClick" />
                    <Button x:Name="BtnGet"
                            Content="Get Lyrictified-Server"
                            Width="150"
                            Margin="0,0,8,0"
                            Style="{StaticResource DialogButtonStyle}"
                            Click="BtnGet_OnClick" />
                    <Button x:Name="BtnExit"
                            Content="Exit"
                            Width="80"
                            Style="{StaticResource DialogButtonStyle}"
                            Click="BtnExit_OnClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
