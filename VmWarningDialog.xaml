<Window x:Class="Lyrictified.VmWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lyrictified - VM Detected"
        Width="540"
        Height="260"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E" />
        <SolidColorBrush x:Key="CardBrush" Color="#1C2128" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A3038" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#333A44" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#161B22"
            BorderBrush="#30363D"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarGrid"
                  Grid.Row="0"
                  Margin="0">
                <TextBlock Text="Lyrictified - VM Detected"
                           VerticalAlignment="Center"
                           Margin="16,0,96,0"
                           Foreground="#DDE9F4"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False" />

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Width="40"
                            Height="30"
                            Padding="0"
                            Click="MinimizeButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0">
                        <Image Source="Assets/minimize.png"
                               Width="10"
                               Height="10"
                               Stretch="Uniform" />
                    </Button>
                    <Button x:Name="CloseWindowButton"
                            Width="40"
                            Height="30"
                            Padding="0"
                            Click="CloseWindowButton_OnClick"
                            Background="Transparent"
                            BorderThickness="0">
                        <Image Source="Assets/close.png"
                               Width="10"
                               Height="10"
                               Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="20,10,20,20">
                <TextBlock Text="We detected that you're running a VM (for testing?). Virtual Machines can fall behind and glitch out in audio. To work around this, we suggest you install Spotify both on your host and the VM, open it on both sides, but play the song from the host side instead. This allows Lyrictified to still get the current playing media through Spotify multi-device notification."
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,16" />

                <Button x:Name="OkButton"
                        Content="OK"
                        Width="120"
                        HorizontalAlignment="Center"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="OkButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
