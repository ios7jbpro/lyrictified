<Window x:Class="Lyrictified.AppBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="136"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="Transparent"
        Topmost="True"
        MouseEnter="Window_OnMouseEnter"
        MouseLeave="Window_OnMouseLeave"
        MouseMove="Window_OnMouseMove">
    <Border x:Name="SurfaceBorder"
            Background="#66101A25"
            BorderBrush="#8A30465C"
            BorderThickness="0,0,0,1"
            CornerRadius="0"
            Padding="18,10">
        <Border.RenderTransform>
            <ScaleTransform x:Name="SurfaceScaleTransform" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="MonitorWarningBanner"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,0,0,8"
                    Padding="12,6"
                    Background="#D9A33A1D"
                    BorderBrush="#F0D38B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Opacity="0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Panel.ZIndex="5">
                <TextBlock x:Name="MonitorWarningTextBlock"
                           Foreground="#FFF3D0"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </Border>
            <StackPanel x:Name="AlbumArtPanel"
                        Grid.Column="0"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                <Grid>
<Border x:Name="AlbumArtBorder"
                         Width="56"
                         Height="56"
                         CornerRadius="10"
                         ClipToBounds="True"
                         Background="#1A2431"
                         BorderBrush="#365067"
                         BorderThickness="1">
                     <Image x:Name="AlbumArtImage"
                            Stretch="UniformToFill"
                            RenderOptions.BitmapScalingMode="HighQuality" />
                 </Border>
                 <Border x:Name="AlbumArtOverlayBorder"
                         Width="56"
                         Height="56"
                         CornerRadius="10"
                         ClipToBounds="True"
                         Background="#1A2431"
                         BorderBrush="#365067"
                         BorderThickness="1"
                         Opacity="0">
                     <Image x:Name="AlbumArtOverlayImage"
                            Stretch="UniformToFill"
                            RenderOptions.BitmapScalingMode="HighQuality" />
                 </Border>
                </Grid>
                <StackPanel x:Name="SongCreditPanel"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock x:Name="SongTitleTextBlock"
                               Foreground="#F5F7FA"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="180" />
                    <TextBlock x:Name="SongArtistTextBlock"
                               Foreground="#9DB1C4"
                               FontSize="11"
                               FontWeight="Medium"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="180" />
                    <TextBlock x:Name="SongTimestampTextBlock"
                               Foreground="#7A8FA3"
                               FontSize="10"
                               FontWeight="Medium"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="180" />
                </StackPanel>
            </StackPanel>
            <Grid Grid.Column="1"
                  Grid.Row="0"
                  VerticalAlignment="Center">
                <Image x:Name="PauseIcon"
                       Width="28"
                       Height="28"
                       Margin="0,0,14,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Opacity="0"
                       Source="Assets/pause.png"
                       Stretch="Uniform"
                       Visibility="Visible"
                       IsHitTestVisible="False" />
                <StackPanel x:Name="LyricsContentPanel"
                            VerticalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="LyricsContentTranslateTransform" X="0" />
                    </StackPanel.RenderTransform>
                    <Grid x:Name="LyricStage"
                          ClipToBounds="True">
                        <TextBlock x:Name="OutgoingLyricTextBlock"
                                   Foreground="#F5F7FA"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Opacity="0"
                                   Margin="0,0,0,6">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="OutgoingLyricTranslateTransform" Y="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="IncomingLyricTextBlock"
                                   Foreground="#F5F7FA"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Opacity="1"
                                   Margin="0,0,0,6">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="IncomingLyricTranslateTransform" Y="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="PreviewLyricTextBlock"
                                   Margin="0,42,0,6"
                                   Foreground="#F5F7FA"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Opacity="0"
                                   Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="PreviewLyricTranslateTransform" Y="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </StackPanel>
                <Grid x:Name="LoadingOverlay"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"
                      Panel.ZIndex="4">
                    <Image x:Name="LoadingSpinnerImage"
                           Width="28"
                           Height="28"
                           Source="Assets/loading.png"
                           Stretch="Uniform"
                           Opacity="0"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="LoadingSpinnerRotateTransform"
                                             Angle="0" />
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </Grid>

            <StackPanel x:Name="ControlButtonsPanel"
                        Grid.Column="2"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Opacity="1">
                <Button x:Name="SettingsButton"
                        Width="72"
                        Height="42"
                        Margin="16,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="SettingsButton_OnClick"
                        Background="#55203344"
                        Foreground="#F5F7FA"
                        BorderBrush="#AA48627A"
                        BorderThickness="1"
                        FontSize="15"
                        Content="Settings" />
                <Button x:Name="SwitchMonitorButton"
                        Width="42"
                        Height="42"
                        Margin="8,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="SwitchMonitorButton_OnClick"
                        Background="#55203344"
                        Foreground="#F5F7FA"
                        BorderBrush="#AA48627A"
                        BorderThickness="1"
                        FontSize="16"
                        Visibility="Collapsed"
                        Content=">" />
                <Button x:Name="CloseButton"
                        Width="42"
                        Height="42"
                        Margin="8,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="CloseButton_OnClick"
                        Background="#55203344"
                        Foreground="#F5F7FA"
                        BorderBrush="#AA48627A"
                        BorderThickness="1"
                        FontSize="18"
                        Content="X" />
            </StackPanel>

            <Border x:Name="ProgressBarTrack"
                         Grid.ColumnSpan="3"
                         Grid.Row="1"
                         Height="3"
                         Background="#0A0E14"
                         CornerRadius="1"
                         Margin="-18,-2,-18,-10">
                <Border x:Name="ProgressBarFill"
                         HorizontalAlignment="Left"
                         Height="3"
                         Background="#5BA3E6"
                         CornerRadius="1"
                         Width="0" />
            </Border>
        </Grid>
    </Border>
</Window>