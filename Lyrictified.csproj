<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <PropertyGroup>
    <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' and Exists('C:\Program Files (x86)\Inno Setup 6\ISCC.exe')">C:\Program Files (x86)\Inno Setup 6\ISCC.exe</InnoSetupCompiler>
    <InnoSetupCompiler Condition="'$(InnoSetupCompiler)' == '' and Exists('C:\Program Files\Inno Setup 6\ISCC.exe')">C:\Program Files\Inno Setup 6\ISCC.exe</InnoSetupCompiler>
    <InstallerOutputDir>$(MSBuildProjectDirectory)\Build-outputs</InstallerOutputDir>
    <InstallerScript>$(MSBuildProjectDirectory)\Installer\Lyrictified.iss</InstallerScript>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\pause.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\loading.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\minimize.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\maximize.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\restore.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\close.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\play-player.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\pause-player.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildInnoSetupInstaller"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipInstallerBuild)' != 'true'">
    <MakeDir Directories="$(InstallerOutputDir)" />
    <Warning Condition="'$(InnoSetupCompiler)' == ''"
             Text="Inno Setup 6 compiler was not found. Install Inno Setup 6 or set InnoSetupCompiler to the full path of ISCC.exe. Skipping installer package." />
    <Message Condition="'$(InnoSetupCompiler)' != ''"
             Text="Building $(Configuration) installer into $(InstallerOutputDir)"
             Importance="High" />
    <Exec Condition="'$(InnoSetupCompiler)' != ''"
          EnvironmentVariables="LYRICTIFIED_APP_NAME=$(AssemblyName);LYRICTIFIED_APP_VERSION=$(Version);LYRICTIFIED_APP_PUBLISHER=$(Company);LYRICTIFIED_SOURCE_DIR=$(TargetDir.TrimEnd('\'));LYRICTIFIED_OUTPUT_DIR=$(InstallerOutputDir);LYRICTIFIED_CONFIGURATION=$(Configuration)"
          Command="&quot;$(InnoSetupCompiler)&quot; /Qp &quot;$(InstallerScript)&quot;" />
  </Target>
</Project>
