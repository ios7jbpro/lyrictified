<Window x:Class="Lyrictified.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="640"
        Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Topmost="False">
    <Grid x:Name="RootGrid"
          Margin="12,0,12,0"
          ClipToBounds="False"
          Background="#00000000">
        <Grid x:Name="OverflowAreaOverlay"
              IsHitTestVisible="False"
              Visibility="Collapsed"
              Panel.ZIndex="-1">
            <Border Height="96" VerticalAlignment="Top" Background="#262A9FFF" />
            <Border Height="96" VerticalAlignment="Bottom" Background="#262A9FFF" />
            <Border Width="96" HorizontalAlignment="Left" Background="#262A9FFF" />
            <Border Width="96" HorizontalAlignment="Right" Background="#262A9FFF" />
        </Grid>
        <Border x:Name="MonitorWarningBanner"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                Padding="10,4"
                Background="#D9A33A1D"
                BorderBrush="#F0D38B"
                BorderThickness="1"
                CornerRadius="8"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="5">
            <TextBlock x:Name="MonitorWarningTextBlock"
                       Foreground="#FFF3D0"
                       FontSize="12"
                       FontWeight="SemiBold" />
        </Border>

        <Grid x:Name="WallpaperLayer"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ClipToBounds="False"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="WallpaperLayerScaleTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="WallpaperLayerVibrateTransform" X="0" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid x:Name="WallpaperTextClip"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ClipToBounds="False">
                <Grid x:Name="LyricStage"
                      Margin="18,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ClipToBounds="False">
                    <Grid x:Name="OutgoingWordsHost" ClipToBounds="False">
                        <StackPanel x:Name="OutgoingWordsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <Grid x:Name="IncomingWordsHost" ClipToBounds="False">
                        <StackPanel x:Name="IncomingWordsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="OutgoingLyricTextBlock"
                               Foreground="#F5F7FA"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ClipToBounds="True"
                               MaxWidth="2000"
                               Padding="0,2"
                               Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="OutgoingLyricTranslateTransform" Y="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="IncomingLyricTextBlock"
                               Foreground="#F5F7FA"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ClipToBounds="True"
                               MaxWidth="2000"
                               Padding="0,2"
                               Opacity="1">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="IncomingLyricTranslateTransform" Y="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
