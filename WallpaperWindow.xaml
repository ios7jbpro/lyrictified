<Window x:Class="Lyrictified.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="640"
        Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Topmost="False">
    <Grid x:Name="RootGrid"
          Margin="12,0,12,0"
          ClipToBounds="False"
          Background="#00000000">
        <Border x:Name="MonitorWarningBanner"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                Padding="10,4"
                Background="#D9A33A1D"
                BorderBrush="#F0D38B"
                BorderThickness="1"
                CornerRadius="8"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="5">
            <TextBlock x:Name="MonitorWarningTextBlock"
                       Foreground="#FFF3D0"
                       FontSize="12"
                       FontWeight="SemiBold" />
        </Border>

        <Grid x:Name="WallpaperLayer"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ClipToBounds="False"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="WallpaperLayerScaleTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="WallpaperLayerVibrateTransform" X="0" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid x:Name="WallpaperTextClip"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ClipToBounds="True">
                <Grid x:Name="LyricStage"
                      Height="30"
                      Margin="18,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="LoadingSpacer"
                            Grid.Column="0"
                            Width="0"
                            VerticalAlignment="Stretch" />
                    <Viewbox x:Name="LoadingIcon"
                             Grid.Column="0"
                             Width="20"
                             Height="20"
                             Margin="0,0,4,0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Opacity="0"
                             Visibility="Collapsed"
                             IsHitTestVisible="False"
                             Panel.ZIndex="2">
                        <Image x:Name="LoadingSpinnerImage"
                               Width="20"
                               Height="20"
                               Source="Assets/loading.png"
                               Stretch="Uniform"
                               Opacity="1"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="LoadingSpinnerRotateTransform"
                                                 Angle="0" />
                            </Image.RenderTransform>
                        </Image>
                    </Viewbox>
                    <StackPanel x:Name="OutgoingWordsPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                    <StackPanel x:Name="IncomingWordsPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                    <TextBlock x:Name="OutgoingLyricTextBlock"
                               Grid.Column="1"
                               Foreground="#F5F7FA"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Padding="0,2"
                               Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="OutgoingLyricTranslateTransform" Y="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="IncomingLyricTextBlock"
                               Grid.Column="1"
                               Foreground="#F5F7FA"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Padding="0,2"
                               Opacity="1">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="IncomingLyricTranslateTransform" Y="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Border x:Name="PauseSpacer"
                            Grid.Column="2"
                            Width="0"
                            VerticalAlignment="Stretch" />
                    <Viewbox x:Name="PauseIcon"
                             Grid.Column="2"
                             Width="20"
                             Height="20"
                             Margin="4,0,0,0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Opacity="0"
                             Visibility="Collapsed"
                             IsHitTestVisible="False"
                             Panel.ZIndex="2">
                        <Canvas Width="20" Height="20">
                            <Rectangle x:Name="PauseBar1" Width="5" Height="14" Canvas.Left="4" Canvas.Top="3" RadiusX="2" RadiusY="2" Fill="#F5F7FA" />
                            <Rectangle x:Name="PauseBar2" Width="5" Height="14" Canvas.Left="11" Canvas.Top="3" RadiusX="2" RadiusY="2" Fill="#F5F7FA" />
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
