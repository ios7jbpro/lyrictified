<Window x:Class="Lyrictified.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lyrictified Settings"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#111821">
    <Grid Margin="22">
        <TabControl Background="#111821"
                    BorderBrush="#2A394A"
                    Foreground="#F5F7FA">
            <TabItem Header="General">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,18,18"
                               VerticalAlignment="Center"
                               Foreground="#E5EDF5"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Display mode" />
                    <ComboBox x:Name="DisplayModeComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,18"
                              MinWidth="240"
                              Padding="10,6"
                              Foreground="#F5F7FA"
                              Background="#1A2431"
                              BorderBrush="#365067"
                              SelectionChanged="DisplayModeComboBox_OnSelectionChanged">
                        <ComboBoxItem Tag="AppBar" Content="App bar" />
                        <ComboBoxItem Tag="Taskbar" Content="Taskbar" />
                    </ComboBox>
                </Grid>
            </TabItem>

            <TabItem Header="App Bar">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,18,18"
                               VerticalAlignment="Center"
                               Foreground="#E5EDF5"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Hide mode" />
                    <ComboBox x:Name="HideModeComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,18"
                              MinWidth="240"
                              Padding="10,6"
                              Foreground="#F5F7FA"
                              Background="#1A2431"
                              BorderBrush="#365067"
                              SelectionChanged="HideModeComboBox_OnSelectionChanged">
                        <ComboBoxItem Tag="Nothing" Content="Nothing" />
                        <ComboBoxItem Tag="Blackout" Content="Blackout" />
                        <ComboBoxItem Tag="Hide" Content="Hide" />
                    </ComboBox>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,18,18"
                               VerticalAlignment="Center"
                               Foreground="#E5EDF5"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Show next line" />
                    <ComboBox x:Name="ShowNextLineComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,0,0,18"
                              MinWidth="240"
                              Padding="10,6"
                              Foreground="#F5F7FA"
                              Background="#1A2431"
                              BorderBrush="#365067"
                              SelectionChanged="ShowNextLineComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="Disabled" />
                        <ComboBoxItem Content="Enabled" />
                    </ComboBox>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Margin="0,0,18,18"
                               VerticalAlignment="Center"
                               Foreground="#E5EDF5"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Display monitor" />
                    <ComboBox x:Name="AppBarMonitorComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,0,18"
                              MinWidth="240"
                              Padding="10,6"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="DeviceName"
                              Foreground="#F5F7FA"
                              Background="#1A2431"
                              BorderBrush="#365067"
                              SelectionChanged="AppBarMonitorComboBox_OnSelectionChanged" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Margin="0,0,18,18"
                               VerticalAlignment="Center"
                               Foreground="#E5EDF5"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Bar height" />
                    <StackPanel Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,0,0,18">
                        <TextBox x:Name="CustomHeightTextBox"
                                 MinWidth="240"
                                 MaxWidth="240"
                                 Padding="10,6"
                                 Foreground="#F5F7FA"
                                 Background="#1A2431"
                                 BorderBrush="#365067"
                                 TextChanged="CustomHeightTextBox_OnTextChanged" />
                        <TextBlock x:Name="BarHeightHintTextBlock"
                                   Margin="0,8,0,0"
                                   Foreground="#9DB1C4"
                                   FontSize="12"
                                   Text="Leave empty to use automatic mode height." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Taskbar">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,18,18"
                               VerticalAlignment="Center"
                               Foreground="#E5EDF5"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Display monitor" />
                    <ComboBox x:Name="TaskbarMonitorComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,18"
                              MinWidth="240"
                              Padding="10,6"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="DeviceName"
                              Foreground="#F5F7FA"
                              Background="#1A2431"
                              BorderBrush="#365067"
                              SelectionChanged="TaskbarMonitorComboBox_OnSelectionChanged" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,18,18"
                               VerticalAlignment="Center"
                               Foreground="#E5EDF5"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Maximum width" />
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,0,18">
                        <TextBox x:Name="TaskbarMaximumWidthTextBox"
                                 MinWidth="240"
                                 MaxWidth="240"
                                 Padding="10,6"
                                 Foreground="#F5F7FA"
                                 Background="#1A2431"
                                 BorderBrush="#365067"
                                 TextChanged="TaskbarMaximumWidthTextBox_OnTextChanged" />
                        <TextBlock x:Name="TaskbarMaximumWidthHintTextBlock"
                                   Margin="0,8,0,0"
                                   Foreground="#9DB1C4"
                                   FontSize="12"
                                   Text="Leave empty to use the default taskbar width cap." />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
