<Window x:Class="Lyrictified.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyrictified Settings"
        Width="680"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161B22" />
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#58A6FF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#79C0FF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F85149" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0D1117" />
        <SolidColorBrush x:Key="CardBrush" Color="#1C2128" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C2128" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C2128" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,0,0" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TabControl x:Name="SettingsTabControl"
                        Grid.Row="1"
                        Background="#0D1117"
                        BorderBrush="Transparent"
                        Margin="0,12,0,0">
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Display Mode" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Choose where lyrics appear on your screen." Style="{StaticResource LabelStyle}" />
                                    <ComboBox x:Name="DisplayModeComboBox"
                                              MinWidth="260"
                                              SelectionChanged="DisplayModeComboBox_OnSelectionChanged">
                                        <ComboBoxItem Tag="AppBar" Content="App bar (top of screen)" />
                                        <ComboBoxItem Tag="Taskbar" Content="Taskbar" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="App Bar">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Lyric Display" Style="{StaticResource SectionTitleStyle}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Show next line" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Preview the upcoming lyric line below the current one." Style="{StaticResource HintTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="ShowNextLineComboBox"
                                                  Grid.Column="1"
                                                  MinWidth="120"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="ShowNextLineComboBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Disabled" />
                                            <ComboBoxItem Content="Enabled" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Karaoke mode" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Dim previous and next lyrics, highlight the current line." Style="{StaticResource HintTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="KaraokeModeComboBox"
                                                  Grid.Column="1"
                                                  MinWidth="120"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="KaraokeModeComboBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Disabled" />
                                            <ComboBoxItem Content="Enabled" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Lyric alignment" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Position lyrics within the bar." Style="{StaticResource HintTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="LyricAlignmentComboBox"
                                                  Grid.Column="1"
                                                  MinWidth="120"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="LyricAlignmentComboBox_OnSelectionChanged">
                                            <ComboBoxItem Tag="Left" Content="Left" />
                                            <ComboBoxItem Tag="Center" Content="Center" />
                                            <ComboBoxItem Tag="Right" Content="Right" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Show album art" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Display album artwork and song info on the left side." Style="{StaticResource HintTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="ShowAlbumArtComboBox"
                                                  Grid.Column="1"
                                                  MinWidth="120"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="ShowAlbumArtComboBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Enabled" />
                                            <ComboBoxItem Content="Disabled" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Hide mode" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Control bar visibility when lyrics are not found." Style="{StaticResource HintTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="HideModeComboBox"
                                                  Grid.Column="1"
                                                  MinWidth="120"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="HideModeComboBox_OnSelectionChanged">
                                            <ComboBoxItem Tag="Nothing" Content="Nothing" />
                                            <ComboBoxItem Tag="Blackout" Content="Blackout" />
                                            <ComboBoxItem Tag="Hide" Content="Hide" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Bar Height" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Custom pixel height. Leave empty for automatic sizing (80px default, 136px with next line)." Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="CustomHeightTextBox"
                                             MinWidth="260"
                                             MaxWidth="260"
                                             TextChanged="CustomHeightTextBox_OnTextChanged" />
                                    <TextBlock x:Name="BarHeightHintTextBlock"
                                               Style="{StaticResource HintTextStyle}"
                                               Text="Leave empty to use the automatic 80px height for this mode." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Display Monitor" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Choose which monitor to display the bar on." Style="{StaticResource LabelStyle}" />
                                    <ComboBox x:Name="AppBarMonitorComboBox"
                                              MinWidth="260"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="DeviceName"
                                              SelectionChanged="AppBarMonitorComboBox_OnSelectionChanged" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Taskbar">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Display Monitor" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Choose which monitor to display lyrics on." Style="{StaticResource LabelStyle}" />
                                    <ComboBox x:Name="TaskbarMonitorComboBox"
                                              MinWidth="260"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="DeviceName"
                                              SelectionChanged="TaskbarMonitorComboBox_OnSelectionChanged" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Maximum Width" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Custom maximum width in pixels. Leave empty for default." Style="{StaticResource LabelStyle}" />
                                    <TextBox x:Name="TaskbarMaximumWidthTextBox"
                                             MinWidth="260"
                                             MaxWidth="260"
                                             TextChanged="TaskbarMaximumWidthTextBox_OnTextChanged" />
                                    <TextBlock x:Name="TaskbarMaximumWidthHintTextBlock"
                                               Style="{StaticResource HintTextStyle}"
                                               Text="Leave empty to use the default 880px taskbar width cap." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Detected Apps">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Media App Ignore Rules" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                                               Text="Lyrictified remembers apps that expose media sessions. Enable ignore for apps you never want to drive lyrics, like web browsers or background players." />
                                    <TextBlock x:Name="DetectedAppsEmptyStateTextBlock"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Text="No media apps detected yet. Start playback in an app and reopen this tab." />

                                    <ListBox x:Name="DetectedAppsListBox"
                                             Visibility="Collapsed"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             SelectionMode="Single"
                                             Margin="-8,0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" />
                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AppId}" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              Margin="12,0,0,0"
                                                              VerticalAlignment="Center"
                                                              Content="Ignore"
                                                              IsChecked="{Binding IsIgnored}"
                                                              Checked="DetectedAppIgnoreCheckBox_OnChanged"
                                                              Unchecked="DetectedAppIgnoreCheckBox_OnChanged" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</Window>